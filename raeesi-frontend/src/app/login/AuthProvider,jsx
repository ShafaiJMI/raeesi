"use client"; // If using App Router

import React, { createContext, useContext, useEffect, useState } from "react";
import axios from "axios";
import { useRouter } from "next/navigation";

const AuthContext = createContext();

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [accessToken, setAccessToken] = useState(null);
  const router = useRouter();

  // Auto refresh access token
  const refreshToken = async () => {
    try {
      const res = await axios.post("/api/token/refresh/", {}, { withCredentials: true });
      setAccessToken(res.data.access);
    } catch (err) {
      console.error("Refresh failed:", err);
      logout(); // Token expired or revoked
    }
  };

  // Auto-refresh every 14 min (if 15 min lifetime)
  useEffect(() => {
    const interval = setInterval(() => {
      refreshToken();
    }, 14 * 60 * 1000);

    return () => clearInterval(interval);
  }, []);

  // On mount, attempt to refresh session
  useEffect(() => {
    refreshToken();
  }, []);

  const login = async (email, password) => {
    const res = await axios.post("/api/token/", { email, password }, { withCredentials: true });
    setAccessToken(res.data.access);
    setUser({ email: res.data.email, username: res.data.username });
    router.push("/dashboard"); // example
  };

  const logout = () => {
    setAccessToken(null);
    setUser(null);
    router.push("/login");
  };

  const value = {
    user,
    accessToken,
    login,
    logout,
    isAuthenticated: !!accessToken,
  };

  return <AuthContext.Provider value={value}>{children}</AuthContext.Provider>;
};

export const useAuth = () => useContext(AuthContext);
